{
  "manifest_version": 3,
  "name": "Dot Cursor",
  "version": "1.4",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["defaults.js", "content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}